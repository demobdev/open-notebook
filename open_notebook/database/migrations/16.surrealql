-- Migration 16: Fix episode profile model names to use gpt-5.2-pro
-- Migration 15 set gpt-5.2 which isn't a valid OpenAI model name.
-- Also update TTS model from gpt-4o-mini-tts to tts-1-hd for reliability.

UPDATE episode_profile SET outline_model = "gpt-5.2-pro" WHERE outline_model = "gpt-5.2" OR outline_model = "gpt-5-mini";
UPDATE episode_profile SET transcript_model = "gpt-5.2-pro" WHERE transcript_model = "gpt-5.2" OR transcript_model = "gpt-5-mini";

UPDATE speaker_profile SET tts_model = "tts-1-hd" WHERE tts_model = "gpt-4o-mini-tts";
